// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id       String         @id @default(uuid())
  email         String         @unique
  fullname      String
  password      String
  salt          String
  status        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  UserProfile   UserProfile[]
  Writer        Writer?                    // one-to-one (optional)

  @@map("users")
}

model Writer {
  writer_id  String   @id @default(uuid())
  user_id    String   @unique                // each user can be a writer only once
  bio        String?
  avatar     String?
  website    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [user_id], references: [user_id])
  posts      Post[] 
  @@map("writers")
}

model UserProfile {
  user_profile_id String   @id @default(uuid())
  user_id         String
  User            User     @relation(fields: [user_id], references: [user_id])
  createdAt       DateTime @default(now())

  @@map("user_profiles")
}


model Post {
  post_id     String   @id @default(uuid())
  title       String
  slug        String   @unique         // readable URL part, e.g. "my-first-post"
  excerpt     String?                  // short summary
  content     String   @db.Text        // full blog content (markdown or HTML)
  cover_image String?                  // optional cover image URL
  published   Boolean  @default(false) // draft vs published
  publishedAt DateTime?                // when first published
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  writer_id   String
  writer      Writer   @relation(fields: [writer_id], references: [writer_id])

  @@index([published])
  @@index([createdAt])
  @@map("posts")
}